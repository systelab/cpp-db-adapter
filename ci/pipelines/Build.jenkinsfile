def version = "0.0.0"
def packageNameInterface = "db-adapter-interface"
def packageNameTestUtilities = "db-adapter-test-utilities"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']


@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'version',
				description: 'Number of the version to build (must match the name of the tag that will be checked out), leave as 0.0.0 for checkout of current branch',
				defaultValue: '0.0.0' )

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				script 
				{
					if (params.version == '0.0.0')
					{
						checkoutSourceCode()
					}
					else
					{
						checkoutSourceCodeFromTag(version)
						version = params.version
					}
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				dir('DbAdapterInterface')
				{
					bat script: "conan create . --version=${version} --profile:all=${env.WORKSPACE}/${profile}", label: "Creating package ${packageNameInterface}/${version}"
				}
				dir('DbAdapterTestUtilities')
				{
					script
					{
						archs.each
						{ arch ->
							configs.each
							{ config ->
								stage("Build ${config}|${arch}")
								{
									bat script: "conan create . --version=${version} --profile:all=${env.WORKSPACE}/${profile} --settings:host build_type=${config} --settings:host arch=${arch}", label: "Creating package ${packageNameTestUtilities}/${version}"
								}
							}
						}
					}
				
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script: "conan upload ${packageNameInterface}/${version} -r aid-conan-production-local --confirm --force", label: "Uploading package for ${packageNameInterface}/${version}"
					bat script: "conan upload ${packageNameTestUtilities}/${version} -r aid-conan-production-local --confirm --force", label: "Uploading packages for ${packageNameTestUtilities}/${version}"
				}
			}
		}
	}
	
	post
	{
		always
		{
			script
			{
				currentBuild.description = "${version}"
			}
		}
	}
}
